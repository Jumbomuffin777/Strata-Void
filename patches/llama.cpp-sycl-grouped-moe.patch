+#undef MMID_G
+
+// Decode-once variant of the grouped MoE kernel for the IQ codebook types. The generic vec_dot re-decodes the
+// codebook for every token; here a lane decodes its 32 weights once into eight signed int8x4 words (plus the
+// scale of each 16-weight half) and then does 8 dp4a per routed row of the tile.
+struct iq_dec32 {
+    int   w[8];
+    float s_lo, s_hi;   // scales of w[0..3] and w[4..7] (block d included; the activation's d is applied per row)
+};
+
+static __dpct_inline__ void iq_dec_iq2_xxs(const void * vbq, int ib32, iq_dec32 & o) {
+    const block_iq2_xxs * b = (const block_iq2_xxs *) vbq;
+    const uint16_t * q2 = b->qs + 4*ib32;
+    const uint8_t  * aux8 = (const uint8_t *) q2;
+    uint32_t aux32 = q2[2] | (q2[3] << 16);
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        const uint32_t * grid  = (const uint32_t *) (iq2xxs_grid + aux8[l]);
+        const uint32_t * signs = (const uint32_t *) (ksigns64 + (aux32 & 127));
+        o.w[2*l+0] = dpct::vectorized_binary<sycl::uchar4>(grid[0] ^ signs[0], signs[0], std::minus<>());
+        o.w[2*l+1] = dpct::vectorized_binary<sycl::uchar4>(grid[1] ^ signs[1], signs[1], std::minus<>());
+        aux32 >>= 7;
+    }
+    o.s_lo = o.s_hi = (float) b->d * (0.5f + aux32) * 0.25f;
+}
+
+static __dpct_inline__ void iq_dec_iq3_xxs(const void * vbq, int ib32, iq_dec32 & o) {
+    const block_iq3_xxs * b = (const block_iq3_xxs *) vbq;
+    const uint8_t  * q3  = b->qs + 8*ib32;
+    const uint16_t * gas = (const uint16_t *) (b->qs + QK_K/4) + 2*ib32;
+    uint32_t aux32 = gas[0] | (gas[1] << 16);
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        const uint32_t * signs = (const uint32_t *) (ksigns64 + (aux32 & 127));
+        o.w[2*l+0] = dpct::vectorized_binary<sycl::uchar4>(iq3xxs_grid[q3[2*l+0]] ^ signs[0], signs[0], std::minus<>());
+        o.w[2*l+1] = dpct::vectorized_binary<sycl::uchar4>(iq3xxs_grid[q3[2*l+1]] ^ signs[1], signs[1], std::minus<>());
+        aux32 >>= 7;
+    }
+    o.s_lo = o.s_hi = (float) b->d * (0.5f + aux32) * 0.5f;
+}
+
+static __dpct_inline__ void iq_dec_iq2_s(const void * vbq, int ib32, iq_dec32 & o) {
+    const block_iq2_s * b = (const block_iq2_s *) vbq;
+    const uint8_t * signs = b->qs + QK_K/8 + 4*ib32;
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        const uint32_t * grid = (const uint32_t *) (iq2s_grid + (b->qs[4*ib32+l] | ((b->qh[ib32] << (8-2*l)) & 0x300)));
+        const uint32_t s0 = dpct::vectorized_binary<sycl::uchar4>(((signs[l] & 0xf) * 0x01010101) & 0x08040201, 0x08040201, std::equal_to<>());
+        const uint32_t s1 = dpct::vectorized_binary<sycl::uchar4>(((signs[l] >> 4)  * 0x01010101) & 0x08040201, 0x08040201, std::equal_to<>());
+        o.w[2*l+0] = dpct::vectorized_binary<sycl::uchar4>(grid[0] ^ s0, s0, std::minus<>());
+        o.w[2*l+1] = dpct::vectorized_binary<sycl::uchar4>(grid[1] ^ s1, s1, std::minus<>());
+    }
+    const float d = (float) b->d * 0.25f;
+    o.s_lo = d * (0.5f + (b->scales[ib32] & 0xf));
+    o.s_hi = d * (0.5f + (b->scales[ib32] >> 4));
+}
+
+template <typename block_q_t, void (*decode)(const void *, int, iq_dec32 &)>
+static void mul_mat_vec_q_moe_grouped_iq(
+    const void * __restrict__ vx_base, const char * __restrict__ vy_sorted,
+    float * __restrict__ dst_sorted, const int32_t * __restrict__ tiles,
+    const int ncols, const int nrows, const size_t expert_weight_stride,
+    const size_t q8_row_stride, const int dst_row_stride,
+    const sycl::nd_item<3> & item_ct1) {
+    constexpr int T = MMID_GROUPED_TILE;
+    constexpr int lanes_per_block = QK_K / 32;               // one lane per 32 weights of a 256-weight block
+    constexpr int blocks_per_warp = WARP_SIZE / lanes_per_block;
+    const int tile = item_ct1.get_group(1);
+    const int row  = item_ct1.get_group(2) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1);
+    if (row >= nrows) {
+        return;
+    }
+    const int e = tiles[3*tile + 0], r0 = tiles[3*tile + 1], nt = tiles[3*tile + 2];
+    const block_q_t * x  = (const block_q_t *) ((const char *) vx_base + (size_t) e * expert_weight_stride);
+    const char *      y0 = vy_sorted + (size_t) r0 * q8_row_stride;
+    const int blocks_per_row = ncols / QK_K;
+    const int lane = item_ct1.get_local_id(2);
+    const int ib32 = lane % lanes_per_block;
+
+    float tmp[T];
+#pragma unroll
+    for (int t = 0; t < T; t++) tmp[t] = 0.0f;
+
+    for (int i = lane / lanes_per_block; i < blocks_per_row; i += blocks_per_warp) {
+        iq_dec32 dw;
+        decode(&x[row * blocks_per_row + i], ib32, dw);
+        const int iby = i * (QK_K / QK8_1) + ib32;
+#pragma unroll
+        for (int t = 0; t < T; t++) {
+            if (t < nt) {
+                const block_q8_1 & yb = ((const block_q8_1 *) (y0 + (size_t) t * q8_row_stride))[iby];
+                const int * q = (const int *) yb.qs;
+                int lo = 0, hi = 0;
+#pragma unroll
+                for (int k = 0; k < 4; k++) lo = dpct::dp4a(dw.w[k], q[k], lo);
+#pragma unroll
+                for (int k = 4; k < 8; k++) hi = dpct::dp4a(dw.w[k], q[k], hi);
+                tmp[t] += (float) yb.ds[0] * (dw.s_lo * lo + dw.s_hi * hi);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < T; t++) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[t] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[t], mask);
+        }
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int t = 0; t < T; t++) {
+            if (t < nt) dst_sorted[(size_t) (r0 + t) * dst_row_stride + row] = tmp[t];
+        }
+    }
+}
+
+template <typename block_q_t, void (*decode)(const void *, int, iq_dec32 &)>
+static void launch_mul_mat_vec_q_moe_grouped_iq(
+    const void * vx_base, const char * vy_sorted, float * dst_sorted, const int32_t * tiles, int n_tiles,
+    int ncols, int nrows, size_t expert_weight_stride, size_t q8_row_stride, int dst_row_stride,
+    dpct::queue_ptr stream) {
+    constexpr int        rows_per_wg = 4;
+    const sycl::range<3> block_nums(1, (unsigned) n_tiles, (unsigned) ((nrows + rows_per_wg - 1) / rows_per_wg));
+    const sycl::range<3> block_dims(1, rows_per_wg, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_grouped_iq<block_q_t, decode>(vx_base, vy_sorted, dst_sorted, tiles, ncols, nrows,
+                    expert_weight_stride, q8_row_stride, dst_row_stride, item);
+            });
+    });
+}
+
+// Returns false for types without a decode-once kernel (the caller then uses the generic grouped kernel).
+bool ggml_sycl_mul_mat_vec_q_id_grouped_iq(
+    enum ggml_type src0_type, const void * vx_base, const char * vy_sorted, float * dst_sorted,
+    const int32_t * tiles, int n_tiles, int ncols, int nrows, size_t expert_weight_stride,
+    size_t q8_row_stride, int dst_row_stride, dpct::queue_ptr stream) {
+    if (WARP_SIZE % (QK_K / 32) != 0) return false;
+#define MMID_GIQ(BLOCK, DEC) launch_mul_mat_vec_q_moe_grouped_iq<BLOCK, DEC>(vx_base, vy_sorted, dst_sorted, tiles, \
+        n_tiles, ncols, nrows, expert_weight_stride, q8_row_stride, dst_row_stride, stream); return true
+    switch (src0_type) {
+        case GGML_TYPE_IQ2_XXS: MMID_GIQ(block_iq2_xxs, iq_dec_iq2_xxs);
+        case GGML_TYPE_IQ3_XXS: MMID_GIQ(block_iq3_xxs, iq_dec_iq3_xxs);
+        case GGML_TYPE_IQ2_S:   MMID_GIQ(block_iq2_s,   iq_dec_iq2_s);
+        default: return false;
+    }
+#undef MMID_GIQ
+}
