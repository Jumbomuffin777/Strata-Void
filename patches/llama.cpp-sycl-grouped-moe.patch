+// Grouped MoE mat-vec for prefill batches (MUL_MAT_ID with many tokens).
+//
+// The routed rows are sorted by expert and cut into tiles of at most MMID_GROUPED_TILE rows of one expert.
+// One launch covers every tile of every expert: a subgroup takes one weight row of the tile's expert and
+// computes its dot products with all of the tile's (Q8_1) activation rows, so each quantized weight block is
+// read once per tile and reused from registers instead of once per token. This replaces the per-expert
+// "dequantize the whole expert to f16, then GEMM" path, whose cost is dominated by materializing ~16 MiB of
+// f16 per expert per op when each expert only receives a few dozen rows.
+// tiles: int32 triplets {expert id, first routed row, rows in tile}.
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_moe_grouped(
+    const void * __restrict__ vx_base, const char * __restrict__ vy_sorted,
+    float * __restrict__ dst_sorted, const int32_t * __restrict__ tiles,
+    const int ncols, const int nrows, const size_t expert_weight_stride,
+    const size_t q8_row_stride, const int dst_row_stride,
+    const sycl::nd_item<3> & item_ct1) {
+    constexpr int T = MMID_GROUPED_TILE;
+    const int tile = item_ct1.get_group(1);
+    const int row  = item_ct1.get_group(2) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1);
+    if (row >= nrows) {
+        return;
+    }
+    const int e  = tiles[3 * tile + 0];
+    const int r0 = tiles[3 * tile + 1];
+    const int nt = tiles[3 * tile + 2];
+
+    const block_q_t * x = (const block_q_t *) ((const char *) vx_base + (size_t) e * expert_weight_stride);
+    const char *      y0 = vy_sorted + (size_t) r0 * q8_row_stride;
+
+    const int     blocks_per_row  = ncols / qk;
+    constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+    float tmp[T];
+#pragma unroll
+    for (int t = 0; t < T; t++) {
+        tmp[t] = 0.0f;
+    }
+
+    for (int i = item_ct1.get_local_id(2) / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i * (qk / QK8_1);
+        for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+            const int iqs = elem + vdr * (item_ct1.get_local_id(2) % (qi / vdr));
+#pragma unroll
+            for (int t = 0; t < T; t++) {
+                if (t < nt) {
+                    const block_q8_1 * y = (const block_q8_1 *) (y0 + (size_t) t * q8_row_stride);
+                    tmp[t] += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < T; t++) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[t] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[t], mask);
+        }
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+#pragma unroll
+        for (int t = 0; t < T; t++) {
+            if (t < nt) {
+                dst_sorted[(size_t) (r0 + t) * dst_row_stride + row] = tmp[t];
+            }
+        }
+    }
+}
+
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_grouped(
+    const void * vx_base, const char * vy_sorted, float * dst_sorted, const int32_t * tiles, int n_tiles,
+    int ncols, int nrows, size_t expert_weight_stride, size_t q8_row_stride, int dst_row_stride,
+    dpct::queue_ptr stream) {
+    constexpr int        rows_per_wg = 4;
+    const int            block_num_y = (nrows + rows_per_wg - 1) / rows_per_wg;
+    const sycl::range<3> block_nums(1, (unsigned) n_tiles, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, rows_per_wg, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_grouped<qk, qi, block_q_t, vdr, vec_dot_q_sycl>(
+                    vx_base, vy_sorted, dst_sorted, tiles, ncols, nrows,
+                    expert_weight_stride, q8_row_stride, dst_row_stride, item);
+            });
+    });
+}
+
+bool ggml_sycl_mul_mat_vec_q_id_grouped_supported(enum ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_IQ2_XXS: case GGML_TYPE_IQ2_XS: case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ3_XXS: case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ1_S:   case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_IQ4_NL:  case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q8_0:
+            return true;
+        default:
+            return false;
+    }
+}
