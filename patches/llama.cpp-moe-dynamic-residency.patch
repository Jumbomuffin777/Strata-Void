+//
+// adaptive hot/cold MoE expert residency
+//
+// A hot/cold-split layer (blk.L.ffn_{gate,up,down}_exps_{hot,cold} + blk.L.ffn_exps_map_{hot,cold}, from a rewritten
+// GGUF or LLAMA_MOE_HOTCOLD) keeps a fixed number of hot slots on its GPU and cold slots in host RAM. The graph marks
+// each such layer's selected expert ids as an output; after every decode they are counted here, and every
+// LLAMA_MOE_INTERVAL tokens the policy (llama-moe-residency.h) may exchange a cold expert with a hot one: the two
+// slots' weights are swapped (one expert slice per role each way) and both maps updated. Hot + cold keep holding every
+// expert exactly once, so outputs are unchanged; only where an expert is computed moves. Slot counts never change,
+// so every device keeps its memory budget.
+//
+
+#include "llama-moe-residency.h"
+
+#include <atomic>
+
+struct llama_moe_runtime {
+    struct layer {
+        int il = -1;
+        ggml_tensor * hot[3]  = {};
+        ggml_tensor * cold[3] = {};
+        ggml_tensor * map_hot  = nullptr;
+        ggml_tensor * map_cold = nullptr;
+        size_t slice[3] = {};
+        int64_t n_expert = 0;
+        std::vector<int32_t> mh, mc; // host copies of the maps
+        int32_t zero_c = 0;          // what the cold map holds for an expert it does not have: -1 (skipped), or its zero expert
+    };
+    std::vector<layer> layers;
+    std::unordered_map<int, int> by_il;
+    std::unique_ptr<llama_moe_residency_policy> pol;
+    bool adapt = true;
+    int interval = 32;
+    int stats_every = 16;
+    int64_t since = 0;
+    int64_t rounds = 0, swaps = 0, tokens = 0;
+    double swap_ms = 0.0;
+    std::vector<uint8_t> a, b;
+};
+
+static std::atomic<int> g_moe_runtime_models{0};
+
+static int moe_env_int(const char * name, int def) {
+    const char * v = getenv(name);
+    return v && *v ? atoi(v) : def;
+}
+
+void llama_moe_runtime_init(llama_model & model) {
+    const char * mode = getenv("LLAMA_MOE_DYNAMIC");
+    const bool dynamic = mode && *mode && strcmp(mode, "0") && strcmp(mode, "off");
+    const char * skip_env = getenv("LLAMA_MOE_COLD_SKIP");
+    const bool skip = !(skip_env && !strcmp(skip_env, "0"));
+    auto find = [&](const std::string & name) -> ggml_tensor * {
+        for (auto & [n, t] : model.tensors_by_name) {
+            if (n == name) {
+                return t;
+            }
+        }
+        return nullptr;
+    };
+    auto rt = std::make_unique<llama_moe_runtime>();
+    rt->adapt = !dynamic || strcmp(mode, "observe") != 0;
+    rt->interval = std::max(1, moe_env_int("LLAMA_MOE_INTERVAL", 32));
+    rt->stats_every = std::max(1, moe_env_int("LLAMA_MOE_STATS_EVERY", 16));
+    std::vector<std::vector<int32_t>> hot, cold;
+    int64_t n_expert = 0;
+    int n_skip = 0;
+    for (int il = 0; il < (int) model.hparams.n_layer(); ++il) {
+        llama_moe_runtime::layer L;
+        L.il = il;
+        L.map_hot  = find(format("blk.%d.ffn_exps_map_hot.weight", il));
+        L.map_cold = find(format("blk.%d.ffn_exps_map_cold.weight", il));
+        if (!L.map_hot || !L.map_cold) {
+            continue;
+        }
+        if (L.map_hot->ne[2] != 1 || L.map_cold->ne[2] != 1) {
+            LLAMA_LOG_WARN("%s: layer %d has per-slot zero experts (CUDA layout): left static\n", __func__, il);
+            continue;
+        }
+        const char * roles[3] = {"gate", "up", "down"};
+        bool cold_on_host = true;
+        for (int r = 0; r < 3; ++r) {
+            L.hot[r]  = find(format("blk.%d.ffn_%s_exps_hot.weight", il, roles[r]));
+            L.cold[r] = find(format("blk.%d.ffn_%s_exps_cold.weight", il, roles[r]));
+            GGML_ASSERT(L.hot[r] && L.cold[r] && L.hot[r]->type == L.cold[r]->type);
+            L.slice[r] = ggml_nbytes(L.hot[r]) / L.hot[r]->ne[2];
+            GGML_ASSERT(L.slice[r] == ggml_nbytes(L.cold[r]) / L.cold[r]->ne[2]);
+            cold_on_host = cold_on_host && L.cold[r]->buffer && ggml_backend_buffer_is_host(L.cold[r]->buffer);
+        }
+        L.n_expert = L.map_hot->ne[1];
+        L.mh.resize(L.n_expert);
+        L.mc.resize(L.n_expert);
+        ggml_backend_tensor_get(L.map_hot,  L.mh.data(), 0, L.n_expert * sizeof(int32_t));
+        ggml_backend_tensor_get(L.map_cold, L.mc.data(), 0, L.n_expert * sizeof(int32_t));
+        const int64_t nh = L.hot[0]->ne[2] - 1, nc = L.cold[0]->ne[2] - 1;   // the last slot: the zero expert
+        std::vector<int32_t> hs(nh, -1), cs(nc, -1);
+        for (int32_t e = 0; e < L.n_expert; ++e) {
+            if (L.mh[e] >= 0 && L.mh[e] < nh) {
+                hs[L.mh[e]] = e;
+            } else if (L.mc[e] >= 0 && L.mc[e] < nc) {
+                cs[L.mc[e]] = e;
+            } else {
+                GGML_ABORT("layer %d: expert %d is neither hot nor cold", il, e);
+            }
+        }
+        GGML_ASSERT(std::find(hs.begin(), hs.end(), -1) == hs.end() && std::find(cs.begin(), cs.end(), -1) == cs.end());
+        // the CPU computes the cold part: an expert it does not hold gets id -1 (no work, an exact 0) instead of the
+        // zero expert, which every hot selection would otherwise run through on the CPU (all of prefill's rows)
+        L.zero_c = (int32_t) nc;
+        if (skip && cold_on_host) {
+            L.zero_c = -1;
+            for (auto & v : L.mc) {
+                if (v == nc) {
+                    v = -1;
+                }
+            }
+            ggml_backend_tensor_set(L.map_cold, L.mc.data(), 0, L.n_expert * sizeof(int32_t));
+            n_skip++;
+        }
+        if (n_expert && n_expert != L.n_expert) {
+            GGML_ABORT("layers with different expert counts are not supported");
+        }
+        n_expert = L.n_expert;
+        rt->by_il[il] = (int) rt->layers.size();
+        rt->layers.push_back(std::move(L));
+        hot.push_back(std::move(hs));
+        cold.push_back(std::move(cs));
+    }
+    if (n_skip > 0) {
+        LLAMA_LOG_INFO("%s: %d hot/cold layers: the CPU skips experts its cold part does not hold\n", __func__, n_skip);
+    }
+    if (!dynamic) {
+        return;
+    }
+    if (rt->layers.empty()) {
+        LLAMA_LOG_WARN("%s: LLAMA_MOE_DYNAMIC is set but the model has no hot/cold-split layers\n", __func__);
+        return;
+    }
+    llama_moe_residency_params p;
+    p.half_life       = (float) moe_env_int("LLAMA_MOE_HALF_LIFE", (int) p.half_life);
+    p.max_swaps_total = moe_env_int("LLAMA_MOE_MAX_SWAPS", p.max_swaps_total);
+    p.max_swaps_layer = moe_env_int("LLAMA_MOE_MAX_SWAPS_LAYER", p.max_swaps_layer);
+    rt->pol = std::make_unique<llama_moe_residency_policy>((int) n_expert, std::move(hot), std::move(cold), p);
+    LLAMA_LOG_INFO("%s: MoE residency %s on %zu hot/cold layers: every %d tokens, at most %d swaps (%d per layer), half-life %.0f\n",
+            __func__, rt->adapt ? "adaptive" : "observing", rt->layers.size(), rt->interval, p.max_swaps_total,
+            p.max_swaps_layer, p.half_life);
+    model.moe_rt = rt.release();
+    g_moe_runtime_models++;
+}
+
+void llama_moe_runtime_free(llama_model & model) {
+    if (model.moe_rt) {
+        g_moe_runtime_models--;
+    }
+    delete model.moe_rt;
+    model.moe_rt = nullptr;
+}
+
+bool llama_moe_runtime_any() {
+    return g_moe_runtime_models > 0;
+}
+
+bool llama_moe_runtime_observing(const llama_model & model) {
+    return model.moe_rt != nullptr;
+}
+
+void llama_moe_runtime_observe(const llama_model & model, int il, const int32_t * ids, int n_tokens, int k) {
+    auto * rt = model.moe_rt;
+    if (!rt) {
+        return;
+    }
+    auto it = rt->by_il.find(il);
+    if (it != rt->by_il.end()) {
+        rt->pol->observe(it->second, ids, n_tokens, k);
+    }
+}
+
+void llama_moe_runtime_step(const llama_model & model, int n_tokens) {
+    auto * rt = model.moe_rt;
+    if (!rt) {
+        return;
+    }
+    rt->tokens += n_tokens;
+    rt->since  += n_tokens;
+    if (rt->since < rt->interval) {
+        return;
+    }
+    rt->since = 0;
+    std::vector<llama_moe_swap> swaps;
+    if (rt->adapt) {
+        swaps = rt->pol->plan();
+    }
+    const int64_t t0 = ggml_time_us();
+    std::vector<uint8_t> touched(rt->layers.size(), 0);
+    for (const auto & w : swaps) {
+        auto & L = rt->layers[w.layer];
+        const int32_t h = rt->pol->hot(w.layer)[w.hot_slot];
+        const int32_t x = rt->pol->cold(w.layer)[w.cold_slot];
+        for (int r = 0; r < 3; ++r) {
+            const size_t n = L.slice[r];
+            rt->a.resize(n);
+            rt->b.resize(n);
+            ggml_backend_tensor_get(L.hot[r],  rt->a.data(), (size_t) w.hot_slot  * n, n);   // h, leaving the GPU
+            ggml_backend_tensor_get(L.cold[r], rt->b.data(), (size_t) w.cold_slot * n, n);   // x, leaving RAM
+            ggml_backend_tensor_set(L.hot[r],  rt->b.data(), (size_t) w.hot_slot  * n, n);
+            ggml_backend_tensor_set(L.cold[r], rt->a.data(), (size_t) w.cold_slot * n, n);
+        }
+        const int32_t zero_h = (int32_t) (L.hot[0]->ne[2] - 1);
+        L.mh[x] = w.hot_slot;  L.mh[h] = zero_h;
+        L.mc[h] = w.cold_slot; L.mc[x] = L.zero_c;
+        touched[w.layer] = 1;
+    }
+    for (size_t l = 0; l < rt->layers.size(); ++l) {
+        if (touched[l]) {
+            auto & L = rt->layers[l];
+            ggml_backend_tensor_set(L.map_hot,  L.mh.data(), 0, L.n_expert * sizeof(int32_t));
+            ggml_backend_tensor_set(L.map_cold, L.mc.data(), 0, L.n_expert * sizeof(int32_t));
+        }
+    }
+    rt->pol->apply(swaps);
+    rt->swap_ms += (ggml_time_us() - t0) / 1000.0;
+    rt->swaps   += (int64_t) swaps.size();
+    if (++rt->rounds % rt->stats_every == 0) {
+        LLAMA_LOG_INFO("moe-residency: %lld tokens, hot hit rate %.2f%% over the last %llu selections, %lld swaps (%.1f ms) so far\n",
+                (long long) rt->tokens, 100.0 * rt->pol->hit_rate(), (unsigned long long) rt->pol->selections(),
+                (long long) rt->swaps, rt->swap_ms);
+        rt->pol->reset_counters();
+    }
+}
