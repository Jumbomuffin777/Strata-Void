+// LLAMA_MOE_HOTCOLD=cold.json ({"<layer>": [canonical expert ids held cold, ...], ...}, the format of
+// tools/moe_placement/llamacpp_hotcold.py --out-cold): every listed layer's routed experts are split into the
+// tensors a rewritten GGUF would hold (blk.L.ffn_{gate,up,down}_exps_{hot,cold} - the experts in canonical order,
+// then one all-zero expert - and blk.L.ffn_exps_map_{hot,cold}), assembled from the original file at load time.
+void llama_model_loader::apply_moe_hotcold(const std::string & path) {
+    std::ifstream in(path);
+    if (!in) {
+        throw std::runtime_error(format("LLAMA_MOE_HOTCOLD: cannot read %s", path.c_str()));
+    }
+    const std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::map<int, std::vector<int32_t>> cold;
+    const std::regex entry("\"(\\d+)\"\\s*:\\s*\\[([^\\]]*)\\]");
+    for (auto it = std::sregex_iterator(text.begin(), text.end(), entry); it != std::sregex_iterator(); ++it) {
+        std::vector<int32_t> ids;
+        const std::string list = (*it)[2].str();
+        const std::regex num("-?\\d+");
+        for (auto n = std::sregex_iterator(list.begin(), list.end(), num); n != std::sregex_iterator(); ++n) {
+            ids.push_back(std::stoi(n->str()));
+        }
+        cold[std::stoi((*it)[1].str())] = std::move(ids);
+    }
+    ggml_init_params params = { ggml_tensor_overhead() * (cold.size() * 8 + 1), nullptr, true };
+    ctx_moe_virtual.reset(ggml_init(params));
+    size_t n_cold_total = 0, bytes_cold = 0;
+    for (const auto & [il, ids] : cold) {
+        if (ids.empty()) {
+            continue;
+        }
+        if (weights_map.count(format("blk.%d.ffn_gate_exps_hot.weight", il))) {
+            throw std::runtime_error(format("LLAMA_MOE_HOTCOLD: layer %d is already split in the file", il));
+        }
+        int64_t n_expert = -1;
+        std::vector<int32_t> hot_ids;
+        for (const char * role : {"gate", "up", "down"}) {
+            const std::string name = format("blk.%d.ffn_%s_exps.weight", il, role);
+            auto it = weights_map.find(name);
+            if (it == weights_map.end()) {
+                throw std::runtime_error(format("LLAMA_MOE_HOTCOLD: layer %d has no %s", il, name.c_str()));
+            }
+            const llama_tensor_weight w = it->second;
+            const ggml_tensor * src = w.tensor;
+            if (n_expert < 0) {
+                n_expert = src->ne[2];
+                std::vector<bool> is_cold(n_expert, false);
+                for (int32_t e : ids) {
+                    if (e < 0 || e >= n_expert || is_cold[e]) {
+                        throw std::runtime_error(format("LLAMA_MOE_HOTCOLD: layer %d: cold ids must be distinct, in 0..%d",
+                                                        il, (int) n_expert - 1));
+                    }
+                    is_cold[e] = true;
+                }
+                for (int32_t e = 0; e < n_expert; ++e) {
+                    if (!is_cold[e]) {
+                        hot_ids.push_back(e);
+                    }
+                }
+            }
+            GGML_ASSERT(src->ne[2] == n_expert && ggml_nbytes(src) % n_expert == 0);
+            const size_t slice = ggml_nbytes(src) / n_expert;
+            for (int part = 0; part < 2; ++part) {
+                auto slots = std::make_shared<std::vector<int32_t>>(part == 0 ? hot_ids : ids);
+                slots->push_back(-1);                                           // the all-zero expert
+                ggml_tensor * t = ggml_new_tensor_3d(ctx_moe_virtual.get(), src->type, src->ne[0], src->ne[1], (int64_t) slots->size());
+                const std::string pname = format("blk.%d.ffn_%s_exps_%s.weight", il, role, part == 0 ? "hot" : "cold");
+                ggml_set_name(t, pname.c_str());
+                llama_tensor_weight v(w.idx, w.offs, t);
+                v.slots = slots;
+                v.slice = slice;
+                weights_map.emplace(pname, v);
+                if (part == 1) {
+                    bytes_cold += ggml_nbytes(t);
+                }
+            }
+            weights_map.erase(it);
+        }
+        for (int part = 0; part < 2; ++part) {
+            const std::vector<int32_t> & list = part == 0 ? hot_ids : ids;
+            auto table = std::make_shared<std::vector<int32_t>>(n_expert, (int32_t) list.size());   // absent -> zero expert
+            for (size_t i = 0; i < list.size(); ++i) {
+                (*table)[list[i]] = (int32_t) i;
+            }
+            ggml_tensor * t = ggml_new_tensor_2d(ctx_moe_virtual.get(), GGML_TYPE_I32, 1, n_expert);
+            const std::string pname = format("blk.%d.ffn_exps_map_%s.weight", il, part == 0 ? "hot" : "cold");
+            ggml_set_name(t, pname.c_str());
+            llama_tensor_weight v(0, 0, t);
+            v.table = table;
+            weights_map.emplace(pname, v);
+        }
+        n_cold_total += ids.size();
+        n_moe_split_layers++;
+    }
+    LLAMA_LOG_INFO("%s: LLAMA_MOE_HOTCOLD %s: %d layers split at load time, %zu cold experts, %.2f GiB cold\n",
+            __func__, path.c_str(), n_moe_split_layers, n_cold_total, bytes_cold / 1024.0 / 1024.0 / 1024.0);
+}
