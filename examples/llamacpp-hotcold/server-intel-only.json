{
  "exe": "third_party/llama.cpp-hotcold/build/bin/llama-server",
  "model": "models/GLM-5.3-Flash-Maya-S-v2-IQ2_XXS-00001-of-00003.gguf",
  "model_name": "glm-5.3-flash-maya-s",
  "args": [
    "--ctx-size",
    "65536",
    "--parallel",
    "1",
    "--batch-size",
    "1024",
    "--ubatch-size",
    "1024",
    "--cache-type-k",
    "q8_0",
    "--cache-type-v",
    "q8_0",
    "--flash-attn",
    "on",
    "--jinja",
    "--no-webui",
    "--threads",
    "16",
    "--threads-batch",
    "16",
    "--device",
    "SYCL0,SYCL1,SYCL2",
    "--split-mode",
    "layer",
    "--tensor-split",
    "17,16,14",
    "--n-gpu-layers",
    "all",
    "-ot",
    "ffn_.*_exps_cold\\.=CPU",
    "--no-op-offload",
    "--load-mode",
    "dio"
  ],
  "env": {
    "LLAMA_MOE_HOTCOLD": "plans/maya-cold-64k.json",
    "LLAMA_DSA_GATHER": "1",
    "ZES_ENABLE_SYSMAN": "1",
    "UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS": "1"
  },
  "hotcold": "auto",
  "log": "llama-server-maya.log",
  "start_timeout_s": 1800,
  "min_free_ram_mib": 20480,
  "lazy_load": true,
  "idle_unload_s": 1800
}
